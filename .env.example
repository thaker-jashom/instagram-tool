NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/food_influencer_db
DIRECT_URL=postgresql://user:password@localhost:5432/food_influencer_db

# API Keys
# Instagram (RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-stable-api.p.rapidapi.com

# YouTube (Google API)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=info